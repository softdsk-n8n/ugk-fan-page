---
import { t } from '../i18n';
const lang: "ru" | "en" = "en";

const members = [
  {
    name: "BUN B",
    realNameKey: "members.bunb.realname",
    roleKey: "members.bunb.role",
    altKey: "members.bunb.alt",
    bioKey: "members.bunb.bio",
    image: "/images/members/bun-b.jpg",
    marker: "ACTIVE",
  },
  {
    name: "PIMP C",
    realNameKey: "members.pimpc.realname",
    roleKey: "members.pimpc.role",
    altKey: "members.pimpc.alt",
    bioKey: "members.pimpc.bio",
    image: "/images/members/pimp-c.webp",
    marker: "1973—2007",
  },
];
---

<section id="members" class="relative py-16 md:py-24 px-6 md:px-12 max-w-[1400px] mx-auto">
  <div class="flex items-center gap-4 mb-12">
    <p class="font-data text-[0.7rem] tracking-[0.1em] text-accent-gold uppercase" data-i18n="members.tag">
      {t[lang]["members.tag"]}
    </p>
    <div class="flex-1 h-[1px]" style="background:rgba(212,168,67,0.3)" aria-hidden="true"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-[1px]" style="background:rgba(212,168,67,0.2)">
    {members.map((member) => (
      <article class="bg-bg p-6 md:p-10 relative group member-card">
        <div class="relative overflow-hidden mb-6">
          <div class="purple-overlay" aria-hidden="true"></div>
          <img
            src={member.image}
            alt={t[lang][member.altKey]}
            data-i18n-alt={member.altKey}
            class="w-full aspect-[4/3] object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <h3 class="font-display text-[clamp(2.5rem,6vw,5rem)] text-fg leading-[0.85] tracking-tight">
          {member.name}
        </h3>

        <p class="font-data text-[0.7rem] tracking-[0.08em] text-accent-gold uppercase mt-2">
          <span data-i18n={member.realNameKey}>{t[lang][member.realNameKey]}</span> / <span data-i18n={member.roleKey}>{t[lang][member.roleKey]}</span>
        </p>

        <div class="w-full h-[1px] my-4" style="background:rgba(212,168,67,0.4)" aria-hidden="true"></div>

        <p class="font-body text-[1rem] leading-[1.7] text-muted-fg max-w-[55ch]" data-i18n={member.bioKey}>
          {t[lang][member.bioKey]}
        </p>

        <span class="absolute top-3 right-4 font-data text-[0.6rem] tracking-[0.1em] text-accent-crimson uppercase" aria-hidden="true">
          {member.marker}
        </span>
      </article>
    ))}
  </div>
</section>
