---
import { t } from '../i18n';
const lang: "ru" | "en" = "en";
---

<section id="intro" class="relative py-16 md:py-24 px-6 md:px-12 max-w-[1400px] mx-auto">
  <div class="flex items-center gap-4 mb-12">
    <h2 class="font-display-mono text-[clamp(1.5rem,4vw,3rem)] text-accent-gold tracking-tight" data-i18n="intro.heading">
      {t[lang]["intro.heading"]}
    </h2>
    <div class="flex-1 h-[1px]" style="background:rgba(212,168,67,0.3)" aria-hidden="true"></div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 md:gap-12">
    <div class="lg:col-span-4 space-y-6">
      <p class="font-body text-[1.125rem] md:text-[1.25rem] leading-[1.7] max-w-[65ch]" data-i18n="intro.p1">
        {t[lang]["intro.p1"]}
      </p>
      <p class="font-body text-[1.125rem] md:text-[1.25rem] leading-[1.7] max-w-[65ch]" data-i18n="intro.p2">
        {t[lang]["intro.p2"]}
      </p>
      <div class="w-24 h-[2px] bg-accent-crimson mt-8" aria-hidden="true"></div>
    </div>

    <div class="lg:col-span-1 flex flex-col justify-end">
      <div class="border-[1px] p-4" style="border-color:rgba(212,168,67,0.4)">
        <p class="font-data text-[0.7rem] tracking-[0.08em] text-muted-fg uppercase leading-relaxed">
          GENRE: DIRTY SOUTH<br/>
          ORIGIN: PORT ARTHUR, TX<br/>
          YEARS: 1992—2009<br/>
          MEMBERS: 02<br/>
          ALBUMS: 06
        </p>
      </div>
    </div>
  </div>
</section>
