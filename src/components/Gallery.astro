---
import { t } from '../i18n';
const lang: "ru" | "en" = "ru";

const galleryImages = [
  { src: "/images/members/ugk-01.webp", alt: "UGK — Bun B and Pimp C together", type: "PHOTO" },
  { src: "/images/members/ugk-02.jpg", alt: "UGK — performing on stage", type: "PHOTO" },
  { src: "/images/members/bun-b.jpg", alt: "Bun B — solo photo", type: "PHOTO" },
  { src: "/images/members/pimp-c.webp", alt: "Pimp C — solo photo", type: "PHOTO" },
  { src: "/images/albums/too-hard-to-swallow.jpg", alt: "Album cover: Too Hard to Swallow (1992)", type: "ALBUM COVER" },
  { src: "/images/albums/super-tight.jpg", alt: "Album cover: Super Tight (1994)", type: "ALBUM COVER" },
  { src: "/images/albums/ridin-dirty.jpg", alt: "Album cover: Ridin' Dirty (1996)", type: "ALBUM COVER" },
  { src: "/images/albums/dirty-money.jpg", alt: "Album cover: Dirty Money (2001)", type: "ALBUM COVER" },
  { src: "/images/albums/underground-kingz.jpg", alt: "Album cover: Underground Kingz (2007)", type: "ALBUM COVER" },
  { src: "/images/albums/ugk-4-life.jpg", alt: "Album cover: UGK 4 Life (2009)", type: "ALBUM COVER" },
];
---

<section id="gallery" class="relative py-16 md:py-24 px-6 md:px-12 max-w-[1400px] mx-auto">
  <div class="flex items-center gap-4 mb-12">
    <h2 class="font-display text-[clamp(2.5rem,6vw,5rem)] text-fg tracking-tight" data-i18n="gallery.heading">
      {t[lang]["gallery.heading"]}
    </h2>
    <div class="flex-1 h-[1px]" style="background:rgba(212,168,67,0.3)" aria-hidden="true"></div>
  </div>
  <p class="font-data text-[0.7rem] tracking-[0.1em] text-accent-gold uppercase mb-10">
    [ GALLERY / 10 IMAGES ]
  </p>

  <div class="masonry-grid">
    {galleryImages.map((img, i) => (
      <div class="gallery-item border-[1px]" style="border-color:rgba(139,111,71,0.3)">
        <img
          src={img.src}
          alt={img.alt}
          class="gallery-img w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="p-2 bg-muted">
          <span class="font-data text-[0.55rem] tracking-[0.1em] text-muted-fg uppercase">
            {img.type} / {String(i + 1).padStart(2, '0')}
          </span>
        </div>
      </div>
    ))}
  </div>

  <p class="font-data text-[0.65rem] tracking-[0.08em] text-muted-fg uppercase mt-8 max-w-[65ch] leading-relaxed" data-i18n="gallery.fairuse">
    {t[lang]["gallery.fairuse"]}
  </p>
</section>
