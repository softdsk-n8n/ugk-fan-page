---
import { t } from '../i18n';
const lang: "ru" | "en" = "ru";
---

<footer id="footer" class="relative border-t-[2px] border-accent-gold">
  <div class="overflow-hidden py-4 bg-muted" aria-hidden="true">
    <div class="marquee-track">
      {Array(2).fill(null).map(() => (
        <p class="font-display text-[clamp(1.5rem,4vw,3rem)] tracking-tight uppercase whitespace-nowrap px-8" style="color:rgba(212,168,67,0.3)">
          UGK FOREVER ★ PIMP C 1973—2007 ★ BUN B ★ PORT ARTHUR TX ★ TRILL ★ UNDERGROUND KINGZ ★ SWEET JAMES JONES ★ DIRTY SOUTH ★
        </p>
      ))}
    </div>
  </div>

  <div class="px-6 md:px-12 max-w-[1400px] mx-auto py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <div>
        <h3 class="font-display text-[1.5rem] tracking-tight text-fg mb-4">DISCLAIMER</h3>
        <p class="font-body text-[0.875rem] leading-[1.7] text-muted-fg max-w-[45ch]" data-i18n="footer.disclaimer">
          {t[lang]["footer.disclaimer"]}
        </p>
      </div>

      <div>
        <h3 class="font-display text-[1.5rem] tracking-tight text-fg mb-4">CREDITS</h3>
        <ul class="space-y-2 font-data text-[0.7rem] tracking-[0.08em] text-muted-fg uppercase leading-relaxed">
          <li data-i18n="footer.credits.photos">{t[lang]["footer.credits.photos"]}</li>
          <li data-i18n="footer.credits.covers">{t[lang]["footer.credits.covers"]}</li>
          <li data-i18n="footer.credits.music">{t[lang]["footer.credits.music"]}</li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-[1.5rem] tracking-tight text-fg mb-4">LINKS</h3>
        <ul class="space-y-2">
          <li><a href="https://UGK.lnk.to/subscribeYD" target="_blank" rel="noopener noreferrer" class="font-data text-[0.7rem] tracking-[0.08em] text-accent-gold uppercase hover:text-fg transition-colors duration-200">UGK YouTube →</a></li>
          <li><a href="https://UGK.lnk.to/listenYD" target="_blank" rel="noopener noreferrer" class="font-data text-[0.7rem] tracking-[0.08em] text-accent-gold uppercase hover:text-fg transition-colors duration-200">UGK Listen →</a></li>
          <li><a href="https://UGK.lnk.to/followYD" target="_blank" rel="noopener noreferrer" class="font-data text-[0.7rem] tracking-[0.08em] text-accent-gold uppercase hover:text-fg transition-colors duration-200">UGK Follow →</a></li>
          <li><a href="https://UGK.lnk.to" target="_blank" rel="noopener noreferrer" class="font-data text-[0.7rem] tracking-[0.08em] text-accent-gold uppercase hover:text-fg transition-colors duration-200">UGK.lnk.to →</a></li>
        </ul>
      </div>
    </div>

    <div class="w-full h-[1px] my-8" style="background:rgba(212,168,67,0.2)" aria-hidden="true"></div>

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="font-display-mono text-[0.85rem] tracking-[0.05em] text-accent-crimson uppercase">
        /// UGK 4 LIFE ///
      </p>
      <p class="font-data text-[0.6rem] tracking-[0.1em] text-muted-fg uppercase">
        FAN PAGE / NOT OFFICIAL / 2026
      </p>
    </div>
  </div>
</footer>
