---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.png' } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;600;700&family=Rubik+Mono+One&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      "name": "UGK",
      "alternateName": "Underground Kingz",
      "foundingLocation": { "@type": "Place", "name": "Port Arthur, Texas" },
      "foundingDate": "1992",
      "member": [
        { "@type": "Person", "name": "Bun B", "alternateName": "Bernard Freeman" },
        { "@type": "Person", "name": "Pimp C", "alternateName": "Chad Butler", "deathDate": "2007-12-04" }
      ],
      "album": [
        { "@type": "MusicAlbum", "name": "Too Hard to Swallow", "datePublished": "1992" },
        { "@type": "MusicAlbum", "name": "Super Tight", "datePublished": "1994" },
        { "@type": "MusicAlbum", "name": "Ridin' Dirty", "datePublished": "1996" },
        { "@type": "MusicAlbum", "name": "Dirty Money", "datePublished": "2001" },
        { "@type": "MusicAlbum", "name": "Underground Kingz", "datePublished": "2007" },
        { "@type": "MusicAlbum", "name": "UGK 4 Life", "datePublished": "2009" }
      ]
    })} />
  </head>
  <body class="bg-[#0D0D0D] text-[#E8E4DE] antialiased overflow-x-hidden">
    <a href="#main" class="skip-link">Перейти к контенту</a>
    <div class="noise-overlay" aria-hidden="true"></div>
    <slot />
  </body>
</html>
